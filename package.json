{
  "name": "booking-assistant-core",
  "version": "0.1.0",
  "description": "Channel-agnostic reference core for a chat booking assistant: double-booking prevention in the database, client isolation with row level security, and a bounded, policy-checked tool surface for the model.",
  "keywords": [
    "booking",
    "appointments",
    "postgres",
    "row-level-security",
    "double-booking",
    "assistant",
    "prompt-injection"
  ],
  "license": "MIT",
  "author": "Kien Phan",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "booking-assistant-core": "dist/bin.js"
  },
  "files": [
    "dist",
    "migrations"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "start": "node dist/bin.js serve",
    "migrate": "node dist/bin.js migrate",
    "demo": "node dist/bin.js demo",
    "check:deps-age": "node scripts/check-dep-age.mjs"
  },
  "dependencies": {
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "5.1.0",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}

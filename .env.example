# Placeholders only. Real values come from your secret store, never from this repository.
# The password of the database role goes in PGPASSWORD (or a .pgpass file), not in the URL.
# 32 random bytes as 64 hex characters, for example: openssl rand -hex 32
DATABASE_URL=postgres://booking_app@db.internal:5432/booking
DATABASE_ADMIN_URL=postgres://schema_owner@db.internal:5432/booking
PGPASSWORD=
# key rings: `id=key,id2=key2` (the first is active) or one bare key; the three keys must all differ
PII_KEYS=
MESSAGE_KEYS=
PHONE_HASH_KEY=
# one or more shared secrets of at least 32 characters, newest first, comma separated
WEBHOOK_SECRETS=
CHANNEL=whatsapp
HOST=127.0.0.1
PORT=8080
MODEL_BASE_URL=https://llm.example.invalid/v1
MODEL_API_KEY=
MODEL_NAME=
RELAY_URL=https://relay.example.invalid/send
RELAY_TOKEN=
DEFAULT_COUNTRY_CODE=
WEBHOOK_REQUESTS_PER_MINUTE=600
WEBHOOK_MAX_BODY_BYTES=65536
WEBHOOK_TOLERANCE_SECONDS=300
TRUSTED_PROXY_HOPS=0
